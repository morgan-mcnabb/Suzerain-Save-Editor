<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SuzerainSaveEditor.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="950" d:DesignHeight="700"
        x:Class="SuzerainSaveEditor.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/app-icon.ico"
        Title="{Binding WindowTitle}"
        Background="{DynamicResource BgBase}"
        Width="950" Height="700"
        MinWidth="700" MinHeight="500">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}" />
    </Window.KeyBindings>

    <Window.Styles>
        <!-- card button: remove default chrome, add hover effect -->
        <Style Selector="Button.card-button">
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.card-button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.card-button:pointerover > Border.sub-card">
            <Setter Property="Background" Value="{DynamicResource BgHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
        </Style>
        <Style Selector="Button.card-button:pointerover > Border.recent-card">
            <Setter Property="Background" Value="{DynamicResource BgHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
        </Style>

        <!-- category tree item styling -->
        <Style Selector="TreeView.category-tree">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TreeView.category-tree TreeViewItem">
            <Setter Property="Padding" Value="2,1" />
        </Style>
        <!-- suppress default TreeViewItem selection highlighting -->
        <Style Selector="TreeView.category-tree TreeViewItem:selected /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="TreeView.category-tree TreeViewItem:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- tree node: hover -->
        <Style Selector="Border.tree-node:pointerover">
            <Setter Property="Background" Value="{DynamicResource BgHover}" />
        </Style>

        <!-- tree node: selected state (overrides hover) -->
        <Style Selector="Border.tree-node-selected">
            <Setter Property="Background" Value="{DynamicResource AccentPrimaryBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
        </Style>
        <Style Selector="Border.tree-node-selected > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>

        <!-- tree node: parent nodes get semibold text -->
        <Style Selector="Border.tree-node-parent > TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- breadcrumb: ancestor segments highlight on hover -->
        <Style Selector="Button.breadcrumb-link:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.breadcrumb-link:pointerover TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" />
        </Style>

        <!-- virtualized field list: suppress ListBox selection/hover chrome -->
        <Style Selector="ListBox.field-list">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style Selector="ListBox.field-list ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="ListBox.field-list ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.field-list ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Window.Styles>

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Resources>
        <!-- reusable field editor template -->
        <DataTemplate x:Key="FieldEditorTemplate" x:DataType="vm:FieldViewModel">
            <Border Classes="field-row"
                    Classes.field-row-dirty="{Binding IsDirty}"
                    Classes.field-row-error="{Binding HasValidationError}">
                <Grid ColumnDefinitions="250,*,Auto" RowDefinitions="Auto,Auto">
                    <!-- label + description -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding Label}"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextPrimary}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Description}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}"
                                   TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding HasDescription}"
                                   Margin="0,2,0,0"
                                   ToolTip.Tip="{Binding Description}" />
                    </StackPanel>

                    <!-- editor controls (only one visible based on type) -->
                    <Panel Grid.Column="1" VerticalAlignment="Center">
                        <!-- bool -->
                        <ToggleSwitch IsChecked="{Binding BoolValue}"
                                      IsVisible="{Binding IsBool}"
                                      OnContent="Yes" OffContent="No"
                                      HorizontalAlignment="Left" />

                        <!-- string / int -->
                        <TextBox Text="{Binding Value, Mode=TwoWay}"
                                 IsVisible="{Binding IsText}"
                                 Watermark="{Binding Description}"
                                 MinWidth="200" />

                        <!-- enum -->
                        <ComboBox ItemsSource="{Binding Options}"
                                  SelectedItem="{Binding Value, Mode=TwoWay}"
                                  IsVisible="{Binding IsEnum}"
                                  MinWidth="200"
                                  HorizontalAlignment="Left" />
                    </Panel>

                    <!-- dirty indicator dot -->
                    <Ellipse Grid.Column="2"
                             Width="8" Height="8"
                             Margin="12,0,4,0"
                             VerticalAlignment="Center"
                             Fill="{DynamicResource StatusDirty}"
                             IsVisible="{Binding IsDirty}"
                             ToolTip.Tip="Modified" />

                    <!-- validation error -->
                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                               Text="{Binding ValidationError}"
                               Foreground="{DynamicResource StatusError}"
                               FontSize="12"
                               Margin="0,4,0,0"
                               IsVisible="{Binding HasValidationError}" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Panel DragDrop.AllowDrop="True" Background="Transparent">
        <!-- loading overlay -->
        <Border IsVisible="{Binding IsLoading}"
                Background="{DynamicResource OverlayBackground}"
                ZIndex="100"
                IsHitTestVisible="True">
            <Border Background="{DynamicResource BgElevated}"
                    CornerRadius="8"
                    Padding="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BoxShadow="0 4 24 0 #40000000">
                <StackPanel Spacing="12">
                    <ProgressBar IsIndeterminate="True"
                                 Width="220"
                                 Foreground="{DynamicResource AccentPrimary}" />
                    <TextBlock Text="{Binding StatusMessage}"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="14" />
                </StackPanel>
            </Border>
        </Border>

        <!-- main layout -->
        <DockPanel>
            <!-- toolbar -->
            <Border DockPanel.Dock="Top" Classes="toolbar">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                Spacing="6">
                        <Button Command="{Binding OpenCommand}"
                                Padding="14,8"
                                ToolTip.Tip="Open a save file (Ctrl+O)">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource IconFolderOpen}"
                                          Width="16" Height="16" />
                                <TextBlock Text="Open" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SaveCommand}"
                                Padding="14,8"
                                Classes="accent"
                                ToolTip.Tip="Save changes (Ctrl+S)">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource IconSave}"
                                          Width="16" Height="16" />
                                <TextBlock Text="Save" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <!-- separator between file ops and edit ops -->
                        <Border Width="1"
                                Height="20"
                                Margin="4,0"
                                Background="{DynamicResource BorderDefault}"
                                VerticalAlignment="Center" />

                        <Button Command="{Binding UndoCommand}"
                                Padding="14,8"
                                ToolTip.Tip="{Binding UndoTooltip}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource IconUndo}"
                                          Width="16" Height="16" />
                                <TextBlock Text="Undo" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding RedoCommand}"
                                Padding="14,8"
                                ToolTip.Tip="{Binding RedoTooltip}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource IconRedo}"
                                          Width="16" Height="16" />
                                <TextBlock Text="Redo" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- separator between edit ops and revert -->
                        <Border Width="1"
                                Height="20"
                                Margin="4,0"
                                Background="{DynamicResource BorderDefault}"
                                VerticalAlignment="Center" />

                        <Button Command="{Binding RevertAllCommand}"
                                Padding="14,8"
                                ToolTip.Tip="Discard all unsaved changes">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource IconUndo}"
                                          Width="16" Height="16" />
                                <TextBlock Text="Revert All" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <TextBox Grid.Column="2"
                             Classes="search-box"
                             Text="{Binding SearchText, Mode=TwoWay}"
                             Watermark="Search fields..."
                             Width="250"
                             VerticalAlignment="Center">
                        <TextBox.InnerLeftContent>
                            <PathIcon Data="{StaticResource IconSearch}"
                                      Width="14" Height="14"
                                      Margin="6,0,0,0"
                                      Foreground="{DynamicResource TextTertiary}" />
                        </TextBox.InnerLeftContent>
                    </TextBox>
                </Grid>
            </Border>

            <!-- status bar -->
            <Border DockPanel.Dock="Bottom" Classes="statusbar">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                    <!-- file path / status -->
                    <TextBlock Grid.Column="0"
                               Text="{Binding StatusMessage}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondary}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />

                    <!-- change count: amber when dirty, secondary when clean -->
                    <Panel Grid.Column="1"
                           Margin="16,0"
                           VerticalAlignment="Center"
                           IsVisible="{Binding IsFileLoaded}">
                        <TextBlock Text="{Binding ChangeCountText}"
                                   FontSize="12"
                                   Foreground="{DynamicResource StatusDirty}"
                                   IsVisible="{Binding IsDirty}" />
                        <TextBlock Text="{Binding ChangeCountText}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}"
                                   IsVisible="{Binding !IsDirty}" />
                    </Panel>

                    <!-- separator -->
                    <Border Grid.Column="2"
                            Width="1"
                            Height="14"
                            Margin="0,0,16,0"
                            Background="{DynamicResource BorderDefault}"
                            VerticalAlignment="Center"
                            IsVisible="{Binding IsFileLoaded}" />

                    <!-- validation status with icons -->
                    <Panel Grid.Column="3"
                           VerticalAlignment="Center"
                           IsVisible="{Binding IsFileLoaded}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="4"
                                    IsVisible="{Binding !HasValidationErrors}">
                            <PathIcon Data="{StaticResource IconCheck}"
                                      Width="12" Height="12"
                                      Foreground="{DynamicResource StatusValid}" />
                            <TextBlock Text="Valid"
                                       FontSize="12"
                                       Foreground="{DynamicResource StatusValid}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="4"
                                    IsVisible="{Binding HasValidationErrors}">
                            <PathIcon Data="{StaticResource IconError}"
                                      Width="12" Height="12"
                                      Foreground="{DynamicResource StatusError}" />
                            <TextBlock Text="{Binding ValidationStatusText}"
                                       FontSize="12"
                                       Foreground="{DynamicResource StatusError}" />
                        </StackPanel>
                    </Panel>
                </Grid>
            </Border>

            <!-- content area -->
            <Panel>
                <!-- empty state: no file loaded -->
                <StackPanel IsVisible="{Binding !IsFileLoaded}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="20"
                            Margin="0,0,0,48">
                    <!-- two-line stacked title -->
                    <StackPanel HorizontalAlignment="Center" Spacing="2">
                        <TextBlock Text="SUZERAIN"
                                   FontSize="32"
                                   FontWeight="Light"
                                   LetterSpacing="4"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource AccentPrimary}" />
                        <TextBlock Text="Save Editor"
                                   FontSize="20"
                                   FontWeight="Light"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimary}" />
                    </StackPanel>

                    <!-- decorative diamond divider -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="8">
                        <Border Height="1" Width="40"
                                Background="{DynamicResource BorderDefault}"
                                VerticalAlignment="Center" />
                        <TextBlock Text="&#x25C6;"
                                   FontSize="10"
                                   Foreground="{DynamicResource AccentPrimary}"
                                   VerticalAlignment="Center" />
                        <Border Height="1" Width="40"
                                Background="{DynamicResource BorderDefault}"
                                VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="Open a save file to begin editing"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSecondary}" />
                    <Button Command="{Binding OpenCommand}"
                            Content="Open Save File"
                            HorizontalAlignment="Center"
                            Padding="32,14"
                            FontSize="14"
                            Classes="accent" />
                    <TextBlock Text="Supports Suzerain and Rizia DLC save files (.json)"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextTertiary}" />
                    <TextBlock Text="or drag and drop a .json file"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextTertiary}" />

                    <!-- recent files list -->
                    <StackPanel IsVisible="{Binding HasRecentFiles}"
                                Spacing="6"
                                Margin="0,8,0,0"
                                Width="420">

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        VerticalAlignment="Center">
                                <PathIcon Data="{StaticResource IconClock}"
                                          Width="13" Height="13"
                                          Foreground="{DynamicResource TextTertiary}" />
                                <TextBlock Text="Recent Files"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Command="{Binding ClearRecentFilesCommand}"
                                    Content="Clear"
                                    FontSize="11"
                                    Padding="8,4"
                                    Foreground="{DynamicResource TextTertiary}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand" />
                        </Grid>

                        <Border Height="1"
                                Background="{DynamicResource BorderSubtle}" />

                        <ItemsControl ItemsSource="{Binding RecentFiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RecentFileViewModel">
                                    <Button Classes="card-button"
                                            Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).OpenRecentFileCommand}"
                                            CommandParameter="{Binding}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Margin="0,2">
                                        <Border Classes="recent-card"
                                                Padding="12,8"
                                                CornerRadius="4"
                                                Background="{DynamicResource BgSurface}"
                                                BorderBrush="{DynamicResource BorderSubtle}"
                                                BorderThickness="1">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontSize="13"
                                                               Foreground="{DynamicResource TextPrimary}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding FilePath}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextTertiary}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip.Tip="{Binding FilePath}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding LastOpened}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextTertiary}"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>

                <!-- loaded state: grouped tabs -->
                <TabControl IsVisible="{Binding IsFileLoaded}"
                            SelectedIndex="{Binding SelectedGroupIndex}"
                            Padding="0"
                            Margin="0">
                    <TabItem Header="General">
                        <ListBox Classes="field-list"
                                 ItemsSource="{Binding GeneralFields}"
                                 ItemTemplate="{StaticResource FieldEditorTemplate}" />
                    </TabItem>

                    <TabItem Header="Sordland">
                        <ListBox Classes="field-list"
                                 ItemsSource="{Binding SordlandFields}"
                                 ItemTemplate="{StaticResource FieldEditorTemplate}" />
                    </TabItem>

                    <TabItem Header="Rizia">
                        <ListBox Classes="field-list"
                                 ItemsSource="{Binding RiziaFields}"
                                 ItemTemplate="{StaticResource FieldEditorTemplate}" />
                    </TabItem>

                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Advanced" />
                                <TextBlock Text="{Binding AdvancedFieldCount, StringFormat='({0})'}"
                                           Foreground="{DynamicResource TextTertiary}" />
                            </StackPanel>
                        </TabItem.Header>

                        <!-- two-panel layout: tree sidebar + content -->
                        <Grid ColumnDefinitions="280,1,*">
                            <!-- left: category tree -->
                            <Border Grid.Column="0"
                                    Background="{DynamicResource BgElevated}"
                                    Padding="4">
                                <TreeView Classes="category-tree"
                                          ItemsSource="{Binding CategoryNodes}"
                                          SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                          AutoScrollToSelectedItem="True">
                                    <TreeView.ItemTemplate>
                                        <TreeDataTemplate x:DataType="vm:CategoryNodeViewModel"
                                                          ItemsSource="{Binding Children}">
                                            <Border Classes="tree-node"
                                                    Padding="8,6"
                                                    CornerRadius="4"
                                                    Background="{DynamicResource BgBase}"
                                                    BorderThickness="3,0,0,0"
                                                    BorderBrush="{DynamicResource BgBase}"
                                                    Classes.tree-node-selected="{Binding IsSelected}"
                                                    Classes.tree-node-parent="{Binding IsParent}">
                                                <Border.Transitions>
                                                    <Transitions>
                                                        <BrushTransition Property="Background" Duration="0:0:0.25" />
                                                        <BrushTransition Property="BorderBrush" Duration="0:0:0.25" />
                                                    </Transitions>
                                                </Border.Transitions>
                                                <TextBlock Text="{Binding HeaderText}"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource TextSecondary}" />
                                            </Border>
                                        </TreeDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
                            </Border>

                            <!-- separator -->
                            <Border Grid.Column="1"
                                    Background="{DynamicResource BorderSubtle}" />

                            <!-- right: selected category content -->
                            <DockPanel Grid.Column="2">
                                <!-- breadcrumb header -->
                                <Border DockPanel.Dock="Top"
                                        Padding="16,10"
                                        BorderThickness="0,0,0,1"
                                        BorderBrush="{DynamicResource BorderSubtle}"
                                        IsVisible="{Binding HasCategorySelected}">
                                    <ItemsControl ItemsSource="{Binding BreadcrumbItems}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:BreadcrumbItem">
                                                <StackPanel Orientation="Horizontal">
                                                    <!-- clickable segment (not last) -->
                                                    <Button Classes="breadcrumb-link"
                                                            Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).NavigateToBreadcrumbCommand}"
                                                            CommandParameter="{Binding}"
                                                            IsVisible="{Binding !IsLast}"
                                                            Padding="4,4"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Cursor="Hand">
                                                        <TextBlock Text="{Binding Label}"
                                                                   FontSize="16"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextSecondary}" />
                                                    </Button>
                                                    <!-- separator (not last) -->
                                                    <TextBlock Text="&#xA0;&gt;&#xA0;"
                                                               FontSize="16"
                                                               Foreground="{DynamicResource TextTertiary}"
                                                               VerticalAlignment="Center"
                                                               IsVisible="{Binding !IsLast}" />
                                                    <!-- current segment (last) -->
                                                    <TextBlock Text="{Binding Label}"
                                                               FontSize="16"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimary}"
                                                               VerticalAlignment="Center"
                                                               IsVisible="{Binding IsLast}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>

                                <!-- content: three mutually exclusive views overlaid -->
                                <Panel>
                                    <!-- empty state: no category selected -->
                                    <StackPanel IsVisible="{Binding !HasCategorySelected}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Spacing="8">
                                        <TextBlock Text="Select a category from the tree"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource TextTertiary}"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="Browse variables organized by namespace and sub-category"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextTertiary}"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>

                                    <!-- sub-category card dashboard (parent nodes) -->
                                    <ScrollViewer IsVisible="{Binding ShowCategoryCards}"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  Padding="16">
                                        <ItemsControl ItemsSource="{Binding SubCategorySummaries}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:SubCategorySummaryViewModel">
                                                    <Button Classes="card-button"
                                                            Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).NavigateToSubCategoryCommand}"
                                                            CommandParameter="{Binding}"
                                                            Margin="0,0,12,12"
                                                            Width="280"
                                                            HorizontalContentAlignment="Stretch"
                                                            Padding="0"
                                                            Background="Transparent"
                                                            BorderThickness="0">
                                                        <Border Classes="sub-card"
                                                                CornerRadius="8"
                                                                Padding="16"
                                                                Background="{DynamicResource BgSurface}"
                                                                BorderBrush="{DynamicResource BorderSubtle}"
                                                                BorderThickness="1">
                                                            <Border.Transitions>
                                                                <Transitions>
                                                                    <BrushTransition Property="BorderBrush" Duration="0:0:0.25" />
                                                                    <BrushTransition Property="Background" Duration="0:0:0.25" />
                                                                </Transitions>
                                                            </Border.Transitions>
                                                            <StackPanel Spacing="8">
                                                                <!-- header: label + count -->
                                                                <Grid ColumnDefinitions="*,Auto">
                                                                    <TextBlock Grid.Column="0"
                                                                               Text="{Binding Label}"
                                                                               FontWeight="SemiBold"
                                                                               FontSize="15"
                                                                               Foreground="{DynamicResource TextPrimary}" />
                                                                    <TextBlock Grid.Column="1"
                                                                               Text="{Binding FieldCount}"
                                                                               FontSize="14"
                                                                               Foreground="{DynamicResource AccentPrimary}" />
                                                                </Grid>

                                                                <!-- header separator -->
                                                                <Border Height="1"
                                                                        Background="{DynamicResource BorderSubtle}"
                                                                        Margin="0,2,0,2" />

                                                                <!-- preview labels -->
                                                                <ItemsControl ItemsSource="{Binding PreviewLabels}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="x:String">
                                                                            <TextBlock Text="{Binding}"
                                                                                       FontSize="12"
                                                                                       Foreground="{DynamicResource TextSecondary}"
                                                                                       TextTrimming="CharacterEllipsis" />
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>

                                                                <!-- +N more -->
                                                                <TextBlock Text="{Binding RemainingText}"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource TextTertiary}"
                                                                           IsVisible="{Binding HasRemaining}" />

                                                                <!-- dirty indicator pill -->
                                                                <Border CornerRadius="10"
                                                                        Background="{DynamicResource StatusDirtyBg}"
                                                                        Padding="8,4"
                                                                        HorizontalAlignment="Left"
                                                                        IsVisible="{Binding HasDirtyFields}">
                                                                    <StackPanel Orientation="Horizontal"
                                                                                Spacing="6">
                                                                        <Ellipse Width="7" Height="7"
                                                                                 VerticalAlignment="Center"
                                                                                 Fill="{DynamicResource StatusDirty}" />
                                                                        <TextBlock Text="{Binding DirtyText}"
                                                                                   FontSize="11"
                                                                                   Foreground="{DynamicResource StatusDirty}" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </StackPanel>
                                                        </Border>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <!-- field list (leaf nodes) -->
                                    <ListBox Classes="field-list"
                                             ItemsSource="{Binding SelectedCategoryFields}"
                                             ItemTemplate="{StaticResource FieldEditorTemplate}"
                                             IsVisible="{Binding ShowCategoryFields}" />
                                </Panel>
                            </DockPanel>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Panel>
        </DockPanel>

        <Border Name="DropOverlay"
                IsVisible="False"
                Background="{DynamicResource OverlayBackground}"
                ZIndex="200"
                IsHitTestVisible="False">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="12">
                <TextBlock Text="Drop save file here"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentPrimary}"
                           HorizontalAlignment="Center" />
                <TextBlock Text=".json files only"
                           FontSize="14"
                           Foreground="{DynamicResource TextTertiary}"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Panel>
</Window>
