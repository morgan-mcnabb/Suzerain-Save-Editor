<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SuzerainSaveEditor.App.App"
             xmlns:local="using:SuzerainSaveEditor.App"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <!-- surface colors (warm-tinted neutrals) -->
        <SolidColorBrush x:Key="BgBase" Color="#1A1917" />
        <SolidColorBrush x:Key="BgSurface" Color="#22211E" />
        <SolidColorBrush x:Key="BgElevated" Color="#2B2A26" />
        <SolidColorBrush x:Key="BgHover" Color="#33322D" />
        <SolidColorBrush x:Key="BgActive" Color="#3B3A35" />

        <!-- accent colors (antique gold) -->
        <SolidColorBrush x:Key="AccentPrimary" Color="#C9952C" />
        <SolidColorBrush x:Key="AccentPrimaryDim" Color="#A67B1E" />
        <SolidColorBrush x:Key="AccentPrimaryBg" Color="#2A2210" />
        <SolidColorBrush x:Key="AccentSecondary" Color="#5B8DEF" />

        <!-- semantic colors -->
        <SolidColorBrush x:Key="StatusDirty" Color="#E8A838" />
        <SolidColorBrush x:Key="StatusDirtyBg" Color="#2A2210" />
        <SolidColorBrush x:Key="StatusValid" Color="#4ADE80" />
        <SolidColorBrush x:Key="StatusError" Color="#EF4444" />
        <SolidColorBrush x:Key="StatusErrorBg" Color="#2D1C1A" />

        <!-- text colors -->
        <SolidColorBrush x:Key="TextPrimary" Color="#EAEAE8" />
        <SolidColorBrush x:Key="TextSecondary" Color="#A09F9A" />
        <SolidColorBrush x:Key="TextTertiary" Color="#6B6A65" />
        <SolidColorBrush x:Key="TextOnAccent" Color="#1A1917" />

        <!-- border colors (warm-tinted) -->
        <SolidColorBrush x:Key="BorderSubtle" Color="#302F2A" />
        <SolidColorBrush x:Key="BorderDefault" Color="#3B3A35" />
        <SolidColorBrush x:Key="BorderStrong" Color="#4B4A44" />
        <SolidColorBrush x:Key="BorderAccent" Color="#C9952C" />

        <!-- loading overlay -->
        <SolidColorBrush x:Key="OverlayBackground" Color="#D91A1917" />

        <!-- textbox theme overrides -->
        <SolidColorBrush x:Key="TextControlBackground" Color="#22211E" />
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#2B2A26" />
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#22211E" />
        <SolidColorBrush x:Key="TextControlBorderBrush" Color="#3B3A35" />
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#4B4A44" />
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#5B8DEF" />
        <SolidColorBrush x:Key="TextControlForeground" Color="#EAEAE8" />
        <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#EAEAE8" />
        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#EAEAE8" />
        <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#6B6A65" />
        <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#6B6A65" />
        <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#6B6A65" />

        <!-- combobox theme overrides -->
        <SolidColorBrush x:Key="ComboBoxBackground" Color="#22211E" />
        <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#2B2A26" />
        <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#22211E" />
        <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#3B3A35" />
        <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#4B4A44" />
        <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#3B3A35" />
        <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#2B2A26" />
        <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#3B3A35" />

        <!-- toggle switch theme overrides -->
        <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#C9952C" />
        <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#A67B1E" />
        <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#8D6819" />
        <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#C9952C" />
        <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#A67B1E" />
        <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#8D6819" />
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#1A1917" />
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#1A1917" />
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#1A1917" />

        <!-- accent button theme overrides (antique gold) -->
        <SolidColorBrush x:Key="AccentButtonBackground" Color="#C9952C" />
        <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#A67B1E" />
        <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#8D6819" />
        <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#3B3A35" />
        <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#C9952C" />
        <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="#A67B1E" />
        <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="#8D6819" />
        <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="#3B3A35" />
        <SolidColorBrush x:Key="AccentButtonForeground" Color="#1A1917" />
        <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#1A1917" />
        <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#1A1917" />
        <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#6B6A65" />

        <!-- regular button theme overrides (ghost style) -->
        <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#33322D" />
        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#3B3A35" />
        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBorderBrush" Color="#3B3A35" />
        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#4B4A44" />
        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#4B4A44" />
        <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#302F2A" />
        <SolidColorBrush x:Key="ButtonForeground" Color="#EAEAE8" />
        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#EAEAE8" />
        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#A09F9A" />
        <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#6B6A65" />

        <!-- tab item theme overrides (underline style) -->
        <SolidColorBrush x:Key="TabItemHeaderBackgroundUnselected" Color="Transparent" />
        <SolidColorBrush x:Key="TabItemHeaderBackgroundSelected" Color="Transparent" />
        <SolidColorBrush x:Key="TabItemHeaderBackgroundUnselectedPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="TabItemHeaderBackgroundSelectedPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="TabItemHeaderBackgroundUnselectedPressed" Color="Transparent" />
        <SolidColorBrush x:Key="TabItemHeaderBackgroundSelectedPressed" Color="Transparent" />
        <SolidColorBrush x:Key="TabItemHeaderForegroundUnselected" Color="#A09F9A" />
        <SolidColorBrush x:Key="TabItemHeaderForegroundSelected" Color="#EAEAE8" />
        <SolidColorBrush x:Key="TabItemHeaderForegroundUnselectedPointerOver" Color="#EAEAE8" />
        <SolidColorBrush x:Key="TabItemHeaderForegroundSelectedPointerOver" Color="#EAEAE8" />
        <SolidColorBrush x:Key="TabItemHeaderForegroundUnselectedPressed" Color="#A09F9A" />
        <SolidColorBrush x:Key="TabItemHeaderForegroundSelectedPressed" Color="#EAEAE8" />
        <SolidColorBrush x:Key="TabItemHeaderSelectedPipeFill" Color="#C9952C" />

        <!-- progress bar theme overrides -->
        <SolidColorBrush x:Key="ProgressBarForeground" Color="#C9952C" />
        <SolidColorBrush x:Key="ProgressBarBackground" Color="#302F2A" />

        <!-- toolbar icon geometries -->
        <StreamGeometry x:Key="IconFolderOpen">M19,20H4C2.89,20 2,19.1 2,18V6C2,4.89 2.89,4 4,4H10L12,6H19A2,2 0 0,1 21,8H21L4,8V18L6.14,10H23.21L20.93,18.5C20.7,19.37 19.92,20 19,20Z</StreamGeometry>
        <StreamGeometry x:Key="IconSave">M15,9H5V5H15M12,19A3,3 0 0,1 9,16A3,3 0 0,1 12,13A3,3 0 0,1 15,16A3,3 0 0,1 12,19M17,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3Z</StreamGeometry>
        <StreamGeometry x:Key="IconUndo">M12.5,8C9.85,8 7.45,9 5.6,10.6L2,7V16H11L7.38,12.38C8.77,11.22 10.54,10.5 12.5,10.5C16.04,10.5 19.05,12.81 20.1,16L22.47,15.22C21.08,11.03 17.15,8 12.5,8Z</StreamGeometry>
        <StreamGeometry x:Key="IconSearch">M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z</StreamGeometry>
        <!-- status icons -->
        <StreamGeometry x:Key="IconCheck">M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z</StreamGeometry>
        <StreamGeometry x:Key="IconError">M13,13H11V7H13M13,17H11V15H13M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z</StreamGeometry>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- textbox and combobox shape -->
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <!-- compact toggle switch to match textbox height -->
        <Style Selector="ToggleSwitch">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <!-- tab item text styling -->
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="20,12" />
        </Style>

        <!-- search textbox: rounded with surface background -->
        <Style Selector="TextBox.search-box">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{DynamicResource BgSurface}" />
        </Style>

        <!-- field row: subtle bottom border separator, consistent height -->
        <Style Selector="Border.field-row">
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="Background" Value="{DynamicResource BgBase}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.25" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.field-row:pointerover">
            <Setter Property="Background" Value="{DynamicResource BgHover}" />
        </Style>

        <!-- dirty field row gets a left accent bar + tinted background -->
        <Style Selector="Border.field-row-dirty">
            <Setter Property="BorderBrush" Value="{DynamicResource StatusDirty}" />
            <Setter Property="BorderThickness" Value="3,0,0,1" />
            <Setter Property="Background" Value="{DynamicResource StatusDirtyBg}" />
        </Style>

        <!-- error field row gets a red-tinted background -->
        <Style Selector="Border.field-row-error">
            <Setter Property="Background" Value="{DynamicResource StatusErrorBg}" />
        </Style>

        <!-- toolbar area -->
        <Style Selector="Border.toolbar">
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Background" Value="{DynamicResource BgElevated}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
        </Style>

        <!-- status bar -->
        <Style Selector="Border.statusbar">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Background" Value="{DynamicResource BgElevated}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
        </Style>

    </Application.Styles>
</Application>
